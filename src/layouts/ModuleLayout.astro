---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';

const { frontmatter, headings, lang } = Astro.props;

const allModules = await getCollection('modules');
const modules = allModules
  .filter(m => m.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.moduleNumber - b.data.moduleNumber);

const currentIndex = modules.findIndex(m => m.data.moduleNumber === frontmatter.moduleNumber);
const prevMod = currentIndex > 0 ? modules[currentIndex - 1] : null;
const nextMod = currentIndex < modules.length - 1 ? modules[currentIndex + 1] : null;

function getSlug(id) {
  const parts = id.split('/');
  return parts[parts.length - 1].replace('.md', '');
}

// Find original ID for current module
const currentMod = modules[currentIndex];
const modSlug = currentMod ? getSlug(currentMod.id) : '';
const isEn = lang === 'en';
---

<BaseLayout title={frontmatter.title} lang={lang}>

  <!-- Client-side script to mark module as complete in localStorage -->
  <script is:inline define:vars={{ modSlug }}>
    document.addEventListener('DOMContentLoaded', () => {
      let progress = {};
      try {
        const stored = localStorage.getItem('aws-saa-progress');
        if (stored) {
          progress = JSON.parse(stored);
        }
      } catch (e) {
        console.error("Could not parse progress", e);
      }

      // Mark this module as 100% complete
      if (modSlug) {
        progress[modSlug] = 100;
        localStorage.setItem('aws-saa-progress', JSON.stringify(progress));
      }

      // Reading progress bar setup
      const progressBar = document.getElementById('reading-progress');
      if (progressBar) {
        window.addEventListener('scroll', () => {
          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          progressBar.style.width = scrolled + "%";
        });
      }
    });
  </script>

  <!-- Sticky Reading Progress Bar -->
  <div class="fixed top-0 left-0 w-full h-1 z-50 bg-transparent">
    <div id="reading-progress" class="h-1 bg-aws-orange w-0 transition-all duration-150"></div>
  </div>

  <div class="flex flex-col lg:flex-row gap-8 py-8 relative">

    <!-- Main Content Area -->
    <main class="w-full lg:w-3/4 order-2 lg:order-1">
      <div class="mb-8">
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4">
          <span class="text-aws-orange block text-lg md:text-xl mb-2 font-bold uppercase tracking-wider">{isEn ? 'Module' : 'บทที่'} {frontmatter.moduleNumber}</span>
          {frontmatter.title}
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">{frontmatter.description}</p>

        <div class="flex flex-wrap gap-2">
          {frontmatter.tags.map(tag => (
             <span class="px-3 py-1 bg-aws-light-blue dark:bg-blue-900/30 text-aws-blue dark:text-blue-400 text-sm font-medium rounded-full border border-blue-200 dark:border-blue-800">
               {tag}
             </span>
          ))}
        </div>
      </div>

      <article class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-aws-blue dark:prose-headings:text-blue-300 prose-a:text-aws-orange hover:prose-a:text-yellow-600">
        <slot />
      </article>

      <!-- Prev / Next Navigation -->
      <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row justify-between gap-4">
        {prevMod ? (
          <a href={`/${lang}/modules/${getSlug(prevMod.id)}`} class="flex-1 p-6 border border-gray-200 dark:border-gray-700 rounded-xl hover:border-aws-orange dark:hover:border-aws-orange group transition-all">
            <span class="text-sm text-gray-500 mb-1 block">{isEn ? 'Previous Module' : 'บทก่อนหน้า'}</span>
            <span class="font-bold text-lg text-aws-blue dark:text-blue-400 group-hover:text-aws-orange transition-colors">&larr; {prevMod.data.title}</span>
          </a>
        ) : (
          <div class="flex-1"></div>
        )}

        {nextMod ? (
          <a href={`/${lang}/modules/${getSlug(nextMod.id)}`} class="flex-1 p-6 border border-gray-200 dark:border-gray-700 rounded-xl hover:border-aws-orange dark:hover:border-aws-orange text-right group transition-all">
            <span class="text-sm text-gray-500 mb-1 block">{isEn ? 'Next Module' : 'บทถัดไป'}</span>
            <span class="font-bold text-lg text-aws-blue dark:text-blue-400 group-hover:text-aws-orange transition-colors">{nextMod.data.title} &rarr;</span>
          </a>
        ) : (
          <div class="flex-1"></div>
        )}
      </div>
    </main>

    <!-- Table of Contents (Sticky on Desktop) -->
    <aside class="w-full lg:w-1/4 order-1 lg:order-2">
      <div class="sticky top-24 bg-gray-50 dark:bg-gray-800/50 p-6 rounded-xl border border-gray-100 dark:border-gray-800">
        <h3 class="font-bold text-lg mb-4 text-gray-900 dark:text-white uppercase tracking-wider text-sm">{isEn ? 'On this page' : 'ในหน้านี้'}</h3>
        <ul class="space-y-3 text-sm">
          {headings && headings.map(h => (
            <li class={`${h.depth > 2 ? 'ml-4 text-gray-500' : 'font-medium text-gray-700 dark:text-gray-300'}`}>
              <a href={`#${h.slug}`} class="hover:text-aws-orange dark:hover:text-aws-orange transition-colors block py-1">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

  </div>
</BaseLayout>
