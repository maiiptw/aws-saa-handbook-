---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'th' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const isEn = lang === 'en';

// Fetch all services and filter by the current language
const allServices = await getCollection('services');
// Astro content collections using glob loader structure their IDs based on the file path
// e.g., 'en/ec2', 'th/s3'
const filteredServices = allServices.filter(service => service.id.startsWith(`${lang}/`));

// Group services by category
const groupedServices = filteredServices.reduce((acc, service) => {
  const category = service.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(service);
  return acc;
}, {} as Record<string, typeof filteredServices>);

// Sort categories (optional, to ensure a specific order like Compute first)
const categoryOrder = ["Compute", "Storage", "Database", "Networking", "Security", "Other"];
const sortedCategories = Object.keys(groupedServices).sort((a, b) => {
  const indexA = categoryOrder.indexOf(a);
  const indexB = categoryOrder.indexOf(b);
  if (indexA === -1 && indexB === -1) return a.localeCompare(b);
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});

const pageTitle = isEn ? "AWS Services Directory" : "ไดเรกทอรีบริการ AWS";
const pageDesc = isEn
  ? "Explore deep dives into specific AWS services to master the architecture and features needed for the SAA-C03 exam."
  : "เจาะลึกบริการ AWS แต่ละตัว เพื่อทำความเข้าใจสถาปัตยกรรมและฟีเจอร์ที่จำเป็นสำหรับการสอบ SAA-C03";
---

<BaseLayout title={pageTitle} lang={lang}>
  <div class="max-w-6xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white mb-4">{pageTitle}</h1>
      <p class="text-xl text-gray-500 dark:text-gray-400 max-w-3xl mx-auto">{pageDesc}</p>
    </div>

    <div class="space-y-16">
      {sortedCategories.map(category => (
        <section>
          <div class="flex items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">{category}</h2>
            <div class="ml-4 flex-grow h-px bg-gray-200 dark:bg-gray-700"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {groupedServices[category].map(service => {
              // Extract the slug (e.g., 'en/ec2' -> 'ec2')
              const slug = service.id.split('/').pop();

              return (
                <a href={`/${lang}/services/${slug}`} class="block group">
                  <div class="h-full border border-gray-200 dark:border-gray-700 rounded-xl p-6 bg-white dark:bg-gray-800 shadow-sm hover:shadow-md transition-all group-hover:border-aws-orange">
                    <div class="flex items-start justify-between mb-4">
                      <div>
                        <span class="inline-block px-2 py-1 bg-gray-100 dark:bg-gray-700 text-xs font-semibold text-gray-600 dark:text-gray-300 rounded mb-2">
                          {service.data.category}
                        </span>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-aws-orange transition-colors">
                          {service.data.title}
                        </h3>
                      </div>
                    </div>
                    <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3">
                      {service.data.description}
                    </p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>